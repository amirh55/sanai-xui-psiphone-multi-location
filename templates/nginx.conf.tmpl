# Generated by install.py — do not edit by hand on a live VPS unless you know nginx.
# Ubuntu 24 / nginx 1.24: use `listen 443 ssl http2;` (NOT `http2 on;`).
# WS locations and optional xHTTP are appended by the installer.

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN__;

    ssl_certificate     __CERT__;
    ssl_certificate_key __KEY__;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache   shared:SSL:10m;

    root /var/www/__DOMAIN__;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location / {
        try_files $uri $uri/ =404;
    }

    # location /ws-de { proxy_pass http://127.0.0.1:10102; ... Upgrade }
    # location /blog  { grpc_pass grpc://127.0.0.1:10088; }
}
